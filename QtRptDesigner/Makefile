qmake: FORCE
	@$(QMAKE) -o Makefile ..\QtRptProject.pro -spec win32-g++ "CONFIG+=qtquickcompiler"

qmake_all: sub-3rdparty-qmake_all sub-QtRptDesigner-qmake_all sub-QtRptDemo-qmake_all FORCE

make_first: sub-3rdparty-make_first-ordered sub-QtRptDesigner-make_first-ordered sub-QtRptDemo-make_first-ordered  FORCE
all: sub-3rdparty-all-ordered sub-QtRptDesigner-all-ordered sub-QtRptDemo-all-ordered  FORCE
clean: sub-3rdparty-clean-ordered sub-QtRptDesigner-clean-ordered sub-QtRptDemo-clean-ordered  FORCE
distclean: sub-3rdparty-distclean-ordered sub-QtRptDesigner-distclean-ordered sub-QtRptDemo-distclean-ordered  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-3rdparty-install_subtargets-ordered sub-QtRptDesigner-install_subtargets-ordered sub-QtRptDemo-install_subtargets-ordered FORCE
uninstall_subtargets: sub-3rdparty-uninstall_subtargets-ordered sub-QtRptDesigner-uninstall_subtargets-ordered sub-QtRptDemo-uninstall_subtargets-ordered FORCE

sub-3rdparty-debug_ordered:
	@if not exist 3rdparty\ mkdir 3rdparty\ & if not exist 3rdparty\ exit 1
	cd 3rdparty\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Projects\QtRptProject\3rdparty\3rdparty.pro -spec win32-g++ "CONFIG+=qtquickcompiler" ) && $(MAKE) -f Makefile debug
