	@if not exist QtRptDesigner\ mkdir QtRptDesigner\ & if not exist QtRptDesigner\ exit 1
	cd QtRptDesigner\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Projects\QtRptProject\QtRptDesigner\QtRptDesigner.pro -spec win32-g++ "CONFIG+=qtquickcompiler" ) && $(MAKE) -f Makefile debug
